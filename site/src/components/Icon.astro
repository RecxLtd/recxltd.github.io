---
interface Props {
  name: 'arrow';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'arrow' && (
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M5 12h14M13 6l6 6-6 6"
    />
  )}
</svg>
